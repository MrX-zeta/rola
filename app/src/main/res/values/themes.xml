<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Ventana del color de fondo: sin destello blanco al abrir. -->
    <style name="Theme.Rola" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/splash_fondo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Rola.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_fondo</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icono</item>
        <item name="postSplashScreenTheme">@style/Theme.Rola</item>
    </style>
</resources>
